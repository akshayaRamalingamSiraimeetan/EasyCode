PORT=7000

# Docker image used to sandbox code execution.
# Override to pin a specific tag in production (e.g. easycode-runner:1.2.0).
RUNNER_IMAGE=easycode-runner:latest

# Path to the Docker socket on the host.
# Override if your deployment uses a non-standard socket location.
DOCKER_SOCKET=/var/run/docker.sock

# Controls which user the Node process runs as at startup.
#   auto    — inspect the socket GID and configure access if possible,
#             then drop to appuser (default; recommended for production)
#   appuser — always run as appuser without inspecting the socket
#   root    — run as root (local development on Docker Desktop / WSL2 only)
RUN_MODE=auto
