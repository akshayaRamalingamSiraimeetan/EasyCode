PORT=7000

# Docker image used to sandbox code execution.
# Override to pin a specific tag in production (e.g. easycode-runner:1.2.0).
RUNNER_IMAGE=easycode-runner:latest

# Path to the Docker socket on the host.
# Override if your deployment uses a non-standard socket location.
DOCKER_SOCKET=/var/run/docker.sock

# ── Workspace directories ─────────────────────────────────────────────────────
#
# JUDGE_TEMP_DIR      — path the judge PROCESS uses to write workspace files.
#                       Must exist and be writable inside the judge container.
#
# HOST_JUDGE_TEMP_DIR — path the Docker DAEMON uses as the bind-mount source
#                       when it spawns runner containers. The daemon resolves
#                       this in its own namespace, not the judge container's.
#                       Defaults to JUDGE_TEMP_DIR when not set (correct for
#                       Linux where there is no namespace difference).
#
# ── Linux / EC2 (single value, no namespace difference) ──────────────────────
#
#   mkdir -p /judge-workspace
#
#   docker run \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /judge-workspace:/judge-workspace \
#     -e JUDGE_TEMP_DIR=/judge-workspace \
#     -p 7001:7000 \
#     judge-service
#
#   HOST_JUDGE_TEMP_DIR is NOT needed on Linux.
#
# ── Docker Desktop on Windows / WSL2 (two values required) ───────────────────
#
#   The Docker daemon runs in a VM. Files written by the judge container are
#   not visible to the daemon at the same Linux path — the daemon sees the
#   Windows host filesystem, not the judge container's namespace.
#
#   The fix: bind-mount the Windows directory into the judge container, then
#   tell dockerExecutor to use the Windows path (C:\...) when constructing
#   the -v flag for runner containers.
#
#   mkdir C:\judge-workspace   (on Windows host, once)
#
#   docker run \
#     -v //var/run/docker.sock:/var/run/docker.sock \
#     -v C:\judge-workspace:/judge-workspace \
#     -e JUDGE_TEMP_DIR=/judge-workspace \
#     -e HOST_JUDGE_TEMP_DIR=C:\judge-workspace \
#     -p 7001:7000 \
#     judge-service
#
#   With this setup:
#     judge writes  → /judge-workspace/<uuid>/solution.py  (container FS)
#     daemon mounts → C:\judge-workspace\<uuid>:/workspace (host FS via VM)
#     Both paths refer to the same files through the Windows↔VM bind mount.

JUDGE_TEMP_DIR=/judge-workspace
HOST_JUDGE_TEMP_DIR=

# Controls which user the Node process runs as at startup.
#   auto    — inspect the socket GID and configure access if possible,
#             then drop to appuser (default; recommended for production)
#   appuser — always run as appuser without inspecting the socket
#   root    — run as root (local development on Docker Desktop / WSL2 only)
RUN_MODE=auto
