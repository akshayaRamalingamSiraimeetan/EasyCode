  "statement": "Given an array of N integers, determine if it is sorted in non-decreasing order (each element is less than or equal to the next).\n\nPrint `YES` if sorted, otherwise print `NO`.",
  "inputFormat": "Line 1: a single integer N.\nLine 2: N space-separated integers.",
  "outputFormat": "`YES` or `NO`.",
  "constraints": "1 <= N <= 10^7\n-10^9 <= A[i] <= 10^9",
  "examples": [
    {
      "input": "5\n1 2 2 3 4",
      "output": "YES",
      "explanation": "Array is non-decreasing (equal adjacent elements are allowed)."
    },
    {
      "input": "4\n1 3 2 4",
      "output": "NO",
      "explanation": "3 > 2, so not sorted."
    }
  ],
  "starterCode": {
    "python": "n = int(input())\na = list(map(int, input().split()))\n# Write your solution here\n",
    "cpp": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) a[i] = sc.nextLong();\n        // Write your solution here\n    }\n}\n"
  },
