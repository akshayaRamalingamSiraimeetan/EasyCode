    "difficulty": "Easy",
    "statement": "Given an array of N integers, find the maximum sum of any contiguous subarray (at least one element).\n\nThis is the classic Kadane's algorithm problem. Return the largest possible sum among all non-empty contiguous subarrays.",
    "constraints": "1 <= N <= 10^6\n-10^9 <= A[i] <= 10^9",
    "inputFormat": "Line 1: a single integer N.\nLine 2: N space-separated integers.",
    "outputFormat": "A single integer: the maximum subarray sum.",
    "examples": [
        {
            "input": "8\n-2 1 -3 4 -1 2 1 -5",
            "output": "6",
            "explanation": "Subarray [4,-1,2,1] has the maximum sum = 6."
        },
        {
            "input": "5\n-3 -1 -4 -1 -5",
            "output": "-1",
            "explanation": "All elements are negative; the best single element is -1."
        }
    ],
