{
    "title": "Move Zeros to End",
    "slug": "move-zeros-to-end",
    "difficulty": "Easy",
    "statement": "Given an array of N integers, move all zeros to the end while preserving the relative order of all non-zero elements. Print the resulting array.\n\nDo this without using an extra array (in-place).",
    "constraints": "1 <= N <= 10^5\n-10^9 <= A[i] <= 10^9",
    "inputFormat": "Line 1: a single integer N.\nLine 2: N space-separated integers.",
    "outputFormat": "N space-separated integers on a single line representing the rearranged array.",
    "examples": [
        {
            "input": "6\n0 1 0 3 12 0",
            "output": "1 3 12 0 0 0",
            "explanation": "Non-zero elements 1, 3, 12 retain their order; zeros are pushed to the end."
        },
        {
            "input": "4\n1 0 0 2",
            "output": "1 2 0 0",
            "explanation": "Non-zero elements 1, 2 stay in order; zeros move to end."
        }
    ],
    "starterCode": {
        "python": "n = int(input())\na = list(map(int, input().split()))\n# Write your solution here (in-place preferred)\n",
        "cpp": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    // Write your solution here\n    return 0;\n}\n",
        "java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) a[i] = sc.nextLong();\n        // Write your solution here\n    }\n}\n"
    },
