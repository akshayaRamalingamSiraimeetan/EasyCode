{
  "title": "Letter Case Permutations",
  "slug": "letter-case-permutations",
  "difficulty": "Medium",
  "statement": "Given an alphanumeric string S, generate all possible strings by toggling the case of each letter (digits remain unchanged).\n\nPrint all results in lexicographic order, one per line.",
  "constraints": "1 <= |S| <= 12\nS contains letters (a-z, A-Z) and digits (0-9).",
  "inputFormat": "A single line containing the string S.",
  "outputFormat": "All permutations (sorted lexicographically), one per line.",
  "examples": [
    {
      "input": "a1b2",
      "output": "A1B2\nA1b2\na1B2\na1b2",
      "explanation": "2 letters -> 4 variants, sorted."
    },
    {
      "input": "3z4",
      "output": "3Z4\n3z4",
      "explanation": "1 letter -> 2 variants."
    }
  ],
  "starterCode": {
    "python": "s = input().strip()\n# Write your solution here\n# Hint: for each position, if letter toggle case; if digit keep; backtrack\n",
    "cpp": "#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; cin >> s;\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        String s = sc.next();\n        // Write your solution here\n    }\n}\n"
  },
  "testCases": [
