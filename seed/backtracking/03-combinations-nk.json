{
  "title": "Combinations C(N, K)",
  "slug": "combinations-n-k",
  "difficulty": "Easy",
  "topic": "Backtracking",
  "tags": [
    "Backtracking"
  ],
  "statement": "Given two integers N and K, compute the number of ways to choose K elements from N distinct elements, where order does not matter.\n\nThis is the binomial coefficient C(N, K) = N! / (K! * (N-K)!).",
  "inputFormat": "A single line containing two integers N and K.",
  "outputFormat": "A single integer: C(N, K).",
  "constraints": "0 <= K <= N <= 30",
  "examples": [
    {
      "input": "4 2",
      "output": "6",
      "explanation": "C(4,2) = 4!/(2!*2!) = 6."
    },
    {
      "input": "5 3",
      "output": "10",
      "explanation": "C(5,3) = 10."
    }
  ],
  "starterCode": {
    "python": "n, k = map(int, input().split())\n# Write your solution here\n",
    "cpp": "#include <iostream>\nusing namespace std;\nint main() {\n    long long n, k; cin >> n >> k;\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong(), k = sc.nextLong();\n        // Write your solution here\n    }\n}\n"
  },
