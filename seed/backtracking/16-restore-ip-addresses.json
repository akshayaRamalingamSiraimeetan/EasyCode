  "statement": "A valid IPv4 address consists of exactly four integers separated by dots, where each integer is between 0 and 255 (inclusive) and has no leading zeros (except \"0\" itself).\n\nGiven a string of digits, return the count of valid IP addresses that can be formed by inserting exactly three dots.",
  "inputFormat": "A single line containing the digit string S.",
  "outputFormat": "A single integer: the count of valid IPv4 addresses.",
  "constraints": "1 <= |S| <= 12\nS contains only digits.",
  "examples": [
    {
      "input": "25525511135",
      "output": "2",
      "explanation": "255.255.11.135 and 255.255.111.35 — 2 valid IPs."
    },
    {
      "input": "0000",
      "output": "1",
      "explanation": "Only 0.0.0.0 is valid."
    }
  ],
  "starterCode": {
    "python": "s = input().strip()\n# Write your solution here\n# Hint: backtrack placing dots; each segment must be 1-3 chars, value 0-255, no leading zeros\n",
    "cpp": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; cin >> s;\n    // Write your solution here\n    return 0;\n}\n",
