{
  "title": "Count All Subsets",
  "slug": "count-all-subsets",
  "difficulty": "Easy",
  "statement": "Given a set of N distinct elements, count the total number of distinct subsets (including the empty set).\n\nEvery set of N distinct elements has exactly 2^N subsets.",
  "constraints": "0 <= N <= 20",
  "inputFormat": "A single line containing N.",
  "outputFormat": "A single integer: 2^N.",
  "examples": [
    {
      "input": "3",
      "output": "8",
      "explanation": "A 3-element set has 2^3 = 8 subsets."
    },
    {
      "input": "0",
      "output": "1",
      "explanation": "The empty set has exactly 1 subset: itself."
    }
  ],
  "starterCode": {
    "python": "n = int(input())\n# Write your solution here\n",
    "cpp": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; cin >> n;\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        // Write your solution here\n    }\n}\n"
  },
