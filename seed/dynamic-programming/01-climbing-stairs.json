  "outputFormat": "A single integer denoting the number of distinct ways.",
  "constraints": "1 <= n <= 45",
  "examples": [
    {
      "input": "2",
      "output": "2",
      "explanation": "Two ways: 1+1 or 2."
    },
    {
      "input": "3",
      "output": "3",
      "explanation": "Three ways: 1+1+1, 1+2, 2+1."
    }
  ],
