  "statement": "Given a non-negative integer N, determine if it is a palindrome.\n\nA palindrome number reads the same forwards and backwards. For example, 121 is a palindrome, but 123 is not.",
  "inputFormat": "A single line containing one non-negative integer N.",
  "outputFormat": "Print \"Yes\" if N is a palindrome, otherwise print \"No\".",
  "constraints": "0 <= N <= 10^9",
  "examples": [
    {
      "input": "121",
      "output": "Yes",
      "explanation": "121 reads the same forwards and backwards."
    },
    {
      "input": "123",
      "output": "No",
      "explanation": "123 reversed is 321, which differs from 123."
    }
  ],
