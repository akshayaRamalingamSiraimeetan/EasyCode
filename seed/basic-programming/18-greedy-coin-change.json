  "statement": "You have an unlimited supply of coins of denominations 1, 5, 10, 25, and 50.\n\nGiven an amount N (in cents), find the minimum number of coins needed to make exactly N cents using the greedy approach (always pick the largest denomination that fits).\n\nNote: The greedy approach works correctly for this specific set of denominations.",
  "inputFormat": "A single line containing one integer N.",
  "outputFormat": "A single integer: the minimum number of coins to make N cents.",
  "constraints": "1 <= N <= 10000",
  "examples": [
    {
      "input": "67",
      "output": "5",
      "explanation": "67 = 50 + 10 + 5 + 1 + 1 → 5 coins."
    },
    {
      "input": "25",
      "output": "1",
      "explanation": "25 cents is exactly one 25-cent coin."
    }
  ],
