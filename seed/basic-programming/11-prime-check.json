  "statement": "Given an integer N, determine whether it is a prime number.\n\nA prime number is a number greater than 1 that has no divisors other than 1 and itself.\n\nPrint \"Prime\" if N is prime, otherwise print \"Not Prime\".",
  "inputFormat": "A single line containing one integer N.",
  "outputFormat": "Print \"Prime\" if N is prime, otherwise print \"Not Prime\".",
  "constraints": "1 <= N <= 10^6",
  "examples": [
    {
      "input": "7",
      "output": "Prime",
      "explanation": "7 has no divisors other than 1 and 7, so it is prime."
    },
    {
      "input": "12",
      "output": "Not Prime",
      "explanation": "12 is divisible by 2, 3, 4, and 6, so it is not prime."
    }
  ],
  "starterCode": {
    "python": "n = int(input())\n# Write your solution here\n",
