  "outputFormat": "A single integer representing the sum of all integers from 1 to N.",
  "constraints": "1 <= N <= 10^6",
  "examples": [
    {
      "input": "5",
      "output": "15",
      "explanation": "1 + 2 + 3 + 4 + 5 = 15"
    },
    {
      "input": "10",
      "output": "55",
      "explanation": "1 + 2 + ... + 10 = 55"
    }
  ],
