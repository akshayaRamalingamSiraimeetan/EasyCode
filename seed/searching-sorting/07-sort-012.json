    "slug": "sort-012-dutch-flag",
    "difficulty": "Easy",
    "statement": "Given an array of N elements where each element is 0, 1, or 2, sort the array in-place such that all 0s come first, then 1s, then 2s.\n\nThis is the Dutch National Flag problem. Solve it in O(N) with only one pass using three pointers: `low`, `mid`, and `high`.\n\nDo NOT use any built-in sort.",
    "constraints": "1 <= N <= 10^6\nA[i] ∈ {0, 1, 2}",
    "inputFormat": "Line 1: a single integer N.\nLine 2: N space-separated integers (each 0, 1, or 2).",
    "outputFormat": "N space-separated integers: the sorted array.",
    "examples": [
        {
            "input": "6\n2 0 1 2 0 1",
            "output": "0 0 1 1 2 2",
            "explanation": "Dutch National Flag: partition into 0s, 1s, 2s."
        },
        {
            "input": "5\n0 0 0 0 0",
            "output": "0 0 0 0 0",
            "explanation": "Already sorted (all 0s)."
        }
    ],
    "starterCode": {
        "python": "n = int(input())\na = list(map(int, input().split()))\nlow, mid, high = 0, 0, n - 1\n# Write your solution here (one pass, three pointers)\n",
        "cpp": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; cin >> n;\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    int lo = 0, mid = 0, hi = n - 1;\n    // Write your solution here\n    return 0;\n}\n",
