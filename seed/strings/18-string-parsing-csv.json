{
  "title": "CSV Field Parser",
  "slug": "csv-field-parser",
  "difficulty": "Medium",
  "topic": "Strings",
  "tags": [
    "Strings"
  ],
  "statement": "Given a single CSV (Comma-Separated Values) line, parse it and print each field on a separate line.\n\nRules:\n- Fields are separated by commas.\n- A field may be quoted with double-quotes (\"). Inside a quoted field, a literal double-quote is represented as two consecutive double-quotes (\"\").\n- Leading and trailing spaces outside quotes are preserved as part of the field.\n- There are no newlines inside fields.",
  "inputFormat": "A single line containing the CSV record.",
  "outputFormat": "Each field on its own line, with surrounding quotes removed and \"\"\" sequences replaced by single \".",
  "constraints": "1 <= |S| <= 10^4\nS contains printable ASCII characters.",
  "examples": [
    {
      "input": "John,25,\"New York\"",
      "output": "John\n25\nNew York",
      "explanation": "Three fields: 'John', '25', and 'New York' (quotes stripped)."
    },
    {
      "input": "\"He said \"\"hello\"\"\",42",
      "output": "He said \"hello\"\n42",
      "explanation": "\"\"\"\"hello\"\"\"\" inside quotes decodes to '\"hello\"'."
    }
  ],
  "starterCode": {
    "python": "s = input()\n# Write your solution here\n",
    "cpp": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s;\n    getline(cin, s);\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        String s = sc.nextLine();\n        // Write your solution here\n    }\n}\n"
  },
