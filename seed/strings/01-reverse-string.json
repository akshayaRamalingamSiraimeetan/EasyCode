  "statement": "Given a string S, print it in reverse order.\n\nFor example, reversing \"hello\" gives \"olleh\".",
  "inputFormat": "A single line containing the string S.",
  "outputFormat": "A single line: the reverse of S.",
  "constraints": "1 <= |S| <= 10^5\nS contains only printable ASCII characters.",
  "examples": [
    {
      "input": "hello",
      "output": "olleh",
      "explanation": "Reading 'hello' from right to left gives 'olleh'."
    },
    {
      "input": "abcde",
      "output": "edcba",
      "explanation": "Reversing 'abcde' yields 'edcba'."
    }
  ],
  "starterCode": {
    "python": "s = input()\n# Write your solution here\n",
