        {
            "input": "abbaca",
            "output": "ca",
            "explanation": "Remove 'bb' -> 'aaca'. Remove 'aa' -> 'ca'."
        },
        {
            "input": "azxxzy",
            "output": "ay",
            "explanation": "Remove 'xx' -> 'azzy'. Remove 'zz' -> 'ay'."
        }
    ],
