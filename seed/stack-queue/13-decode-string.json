{
    "title": "Decode String",
    "slug": "decode-string",
    "difficulty": "Medium",
    "statement": "Given an encoded string, return its decoded string.\n\nThe encoding rule is: `k[encoded_string]`, where the encoded_string inside the square brackets is being repeated exactly k times. k is guaranteed to be a positive integer.\n\nYou may assume that the input string is always valid; No extra white spaces, square brackets are well-formed, etc.",
    "constraints": "1 <= |S| <= 100\nS contains only lowercase English letters, digits, and square brackets '[]'.\nThe decoded string will not exceed 10^5 characters.",
    "inputFormat": "A single line containing the string S.",
    "outputFormat": "The decoded string on a single line.",
    "examples": [
        {
            "input": "3[a]2[bc]",
            "output": "aaabcbc",
            "explanation": "3 times 'a' and 2 times 'bc'."
        },
        {
            "input": "3[a2[c]]",
            "output": "accaccacc",
            "explanation": "Inner is 'c' repeated 2 times giving 'acc', repeating 3 times gives 'accaccacc'."
        }
    ],
    "starterCode": {
        "python": "s = input().strip()\n# Write your stack-based decoding logic\n",
        "cpp": "#include <iostream>\n#include <string>\n#include <stack>\nusing namespace std;\nint main() {\n    string s; cin >> s;\n    // Write your solution here\n    return 0;\n}\n",
        "java": "import java.util.*;\nimport java.io.*;\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine().trim();\n        // Write your solution here\n    }\n}\n"
    },
