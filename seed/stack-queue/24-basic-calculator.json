{
    "title": "Basic Calculator",
    "slug": "basic-calculator",
    "difficulty": "Hard",
    "statement": "Given a string `s` representing a valid expression, implement a basic calculator to evaluate it, and return the result of the evaluation.\n\nThe string `s` consists of digits, '+', '-', '(', ')', and spaces ' '.\nThere is no multiplication or division.",
    "constraints": "1 <= |s| <= 10^5\nAll intermediate results are in the range of [-2^31, 2^31 - 1].",
    "inputFormat": "A single line containing the string `s`.",
    "outputFormat": "A single integer: the evaluated result.",
    "examples": [
        {
            "input": "1 + 1",
            "output": "2",
            "explanation": "1 + 1 = 2."
        },
        {
            "input": " 2-1 + 2 ",
            "output": "3",
            "explanation": "2 - 1 + 2 = 3."
        },
        {
            "input": "(1+(4+5+2)-3)+(6+8)",
            "output": "23",
            "explanation": "(1 + 11 - 3) + 14 = 9 + 14 = 23."
        }
    ],
    "starterCode": {
        "python": "s = input().strip()\n# Write your solution using a stack to handle parenthesis and sign\n",
        "cpp": "#include <iostream>\n#include <string>\n#include <stack>\nusing namespace std;\nint main() {\n    string s;\n    getline(cin, s);\n    // Write your solution here\n    return 0;\n}\n",
        "java": "import java.util.*;\nimport java.io.*;\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine();\n        // Write your solution here\n    }\n}\n"
    },
