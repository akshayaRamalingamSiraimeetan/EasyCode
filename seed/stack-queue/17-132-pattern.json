{
    "title": "132 Pattern",
    "slug": "132-pattern",
    "difficulty": "Medium",
    "statement": "Given an array of N integers, return `YES` if there is a 132 pattern in the array, otherwise return `NO`.\n\nA 132 pattern is a subsequence of three integers A[i], A[j] and A[k] such that i < j < k and A[i] < A[k] < A[j].\n\nUse a monotonic stack.",
    "constraints": "1 <= N <= 10^5\n-10^9 <= A[i] <= 10^9",
    "inputFormat": "Line 1: an integer N.\nLine 2: N space-separated integers.",
    "outputFormat": "`YES` or `NO`.",
    "examples": [
        {
            "input": "4\n1 2 3 4",
            "output": "NO",
            "explanation": "There is no 132 pattern in the sequence."
        },
        {
            "input": "4\n3 1 4 2",
            "output": "YES",
            "explanation": "There is a 132 pattern: [1, 4, 2]."
        },
        {
            "input": "5\n-1 3 2 0",
            "output": "YES",
            "explanation": "[-1, 3, 2], [-1, 3, 0], and [-1, 2, 0] are valid 132 patterns."
        }
    ],
    "starterCode": {
        "python": "n = int(input())\na = list(map(int, input().split()))\n# Write your monotonic stack solution here\n# Iterate from right to left\n",
        "cpp": "#include <iostream>\n#include <vector>\n#include <stack>\nusing namespace std;\nint main() {\n    int n; cin >> n;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    // Write your solution here\n    return 0;\n}\n",
        "java": "import java.util.*;\nimport java.io.*;\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        long[] a = new long[n];\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < n; i++) a[i] = Long.parseLong(st.nextToken());\n        // Write your solution here\n    }\n}\n"
    },
