  "statement": "Given an array of integers, determine if any value appears at least twice.\n\nPrint \"Yes\" if a duplicate exists, otherwise print \"No\".",
  "inputFormat": "The first line contains N.\nThe second line contains N space-separated integers.",
  "outputFormat": "Print \"Yes\" if a duplicate exists, otherwise \"No\".",
  "constraints": "1 <= N <= 10^5\n-10^6 <= A[i] <= 10^6",
  "examples": [
    {
      "input": "4\n1 2 3 1",
      "output": "Yes",
      "explanation": "The value 1 appears at indices 0 and 3."
    },
    {
      "input": "4\n1 2 3 4",
      "output": "No",
      "explanation": "All values are distinct."
    }
  ],
  "starterCode": {
    "python": "n = int(input())\narr = list(map(int, input().split()))\n# Write your solution here\n",
    "cpp": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; cin >> n;\n    vector<int> arr(n);\n    for (int i = 0; i < n; i++) cin >> arr[i];\n    // Write your solution here\n    return 0;\n}\n",
    "java": "import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();\n        // Write your solution here\n    }\n}\n"
  },
